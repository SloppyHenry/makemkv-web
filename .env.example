# Kopie als .env ablegen und anpassen (install.sh macht das automatisch)
PORT=8780
PUID=1000                      # Benutzer, dem die gerippten Dateien gehören
PGID=1000
CDROM_GID=24                   # getent group cdrom
TZ=Europe/Berlin
NAS_MOUNT=/mnt/nas      # eingehängtes Ziel (NFS/SMB) – muss als Verzeichnis existieren
OUTPUT_DIR=/mnt/nas/rips
STAGING_PATH=./data/staging    # lokaler Zwischenspeicher, braucht Platz für den größten Titel (+ Konvertierung)
INSTANCE_NAME=mein-server        # Name dieser Instanz (erscheint in Sperrdateien, wenn mehrere Instanzen dasselbe Ziel nutzen)
PEERS=                         # andere MakeMKV-Web-Rechner für die Übergabe, z. B. server2=http://192.0.2.20:8780,server3=http://192.0.2.30:8780
MKV_VERSION=latest             # oder feste Version, z. B. 2.0.0
AUTH_USER=admin
AUTH_PASS=                     # leer = keine Anmeldung (nur im vertrauenswürdigen LAN!)
