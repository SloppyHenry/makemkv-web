# Save a copy as .env and adjust it (install.sh does this automatically)
PORT=8780
PUID=1000                      # user that owns the ripped files
PGID=1000
CDROM_GID=24                   # getent group cdrom
RENDER_GID=105                 # getent group render (only needed for hardware encoding)
NVIDIA=auto                    # pass an NVIDIA card through (NVENC): auto = if present, no = never
TZ=Europe/Berlin
NAS_MOUNT=/mnt/nas      # mounted target (NFS/SMB) – must exist as a directory
OUTPUT_DIR=/mnt/nas/rips
STAGING_PATH=./data/staging    # local staging buffer, needs room for the largest title (+ conversion)
INSTANCE_NAME=my-server        # name of this instance (appears in lock files when several instances share the same target)
PEERS=                         # other Spindle machines for hand-over, e.g. server2=http://192.0.2.20:8780,server3=http://192.0.2.30:8780
MKV_VERSION=latest             # or a fixed version, e.g. 2.0.0
AUTH_USER=admin
AUTH_PASS=                     # empty = no login (trusted LAN only!)
